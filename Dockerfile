# =============================================================================
# BlueSpark simulation image
#   ROS 2 Jazzy + Gazebo Harmonic + ArduSub SITL + ardupilot_gazebo plugin
# =============================================================================
#
# What runs where once everything is started:
#
#   bluespark repo (other container)            this image (bs_sim)
#   -------------------------------             -------------------------------
#   BlueSpark ROS 2 nodes                       ArduSub SITL  <-- JSON / UDP 9002 -->
#        |  ROS topics / services                    |          ArduPilotPlugin
#      MAVROS  <---- MAVLink, UDP 14550 ---->  MAVProxy               |
#                                                                 Gazebo (physics)
#
# - ArduSub SITL is the same ArduSub firmware that runs on the Pixhawk, compiled
#   for Linux. Instead of reading real sensors and driving real ESCs, it gets the
#   vehicle state from Gazebo and sends motor PWM back to Gazebo.
# - ArduPilotPlugin (from ardupilot_gazebo) is loaded by Gazebo from the BlueROV2
#   model (models/bluerov2/model.sdf). It is the Gazebo side of that link.
# - MAVProxy is started by sim_vehicle.py (see scripts/run_ardusub.sh). It is a
#   text ground station and also forwards all MAVLink traffic to udp
#   127.0.0.1:14550, where MAVROS from the bluespark container connects
#   (fcu_url:=udp://:14550@). Both containers use network_mode: host, so
#   127.0.0.1 is the same machine for both.
#
# Build cache note:
#   Docker rebuilds a changed line and every line below it. The ArduSub compile
#   is the slowest step (10-20 min), so it sits above the steps that are more
#   likely to change. Add new apt/pip packages BELOW it (switching to root for a
#   moment, as done for the plugin) unless you want to recompile ArduSub.
#
# After editing this file the container must be recreated:
#   docker compose down && ./start_docker.sh
# =============================================================================

FROM ros:jazzy-ros-base

# -----------------------------------------------------------------------------
# Gazebo and graphics
# -----------------------------------------------------------------------------
# ros-jazzy-ros-gz installs Gazebo Harmonic (as ROS "vendor" packages under
# /opt/ros/jazzy) together with the ROS <-> Gazebo bridge. The mesa/libgl
# packages provide OpenGL so the Gazebo window can render from the container
# (the display socket and /dev/dri are passed in by docker-compose.yaml).
RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-gz \
    mesa-utils \
    libgl1 \
    libglx-mesa0 \
    libgl1-mesa-dri \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# ArduSub build dependencies (system packages, installed as root)
# -----------------------------------------------------------------------------
# git              - clone ArduPilot and ardupilot_gazebo
# build-essential  - C++ compiler (g++) and make
# python3-pip      - to install the Python packages below
# python3-numpy    - from apt on purpose: the pip version may be newer than the
#                    one ROS 2 Jazzy was built against and break ROS tools
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    python3-pip \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python packages for ArduPilot, sim_vehicle.py and MAVProxy
# -----------------------------------------------------------------------------
# empy==3.3.4, future, dronecan - used at build time: part of the ArduPilot C++
#                    code (MAVLink, DroneCAN) is generated by Python scripts.
#                    empy 4.x is not compatible, hence the pinned version.
# pexpect          - used by Tools/autotest/sim_vehicle.py
# pymavlink, pyserial, defusedxml, pynmeagps - runtime dependencies of MAVProxy
# MAVProxy --no-deps - skips MAVProxy's GUI dependencies (VTK, OpenCV,
#                    matplotlib, several GB). The console works without them;
#                    only graphical modules such as "map" are unavailable.
# --break-system-packages - Ubuntu 24.04 blocks pip installs into the system
#                    Python by default; acceptable inside a container (the
#                    bluespark repo's Dockerfile does the same).
RUN pip3 install --break-system-packages \
        empy==3.3.4 pexpect future dronecan \
        pymavlink pyserial defusedxml pynmeagps \
    && pip3 install --break-system-packages --no-deps MAVProxy

# -----------------------------------------------------------------------------
# User setup
# -----------------------------------------------------------------------------
# The base image (Ubuntu 24.04) already has a non-root user "ubuntu".
# Give it passwordless sudo so packages can be added inside a running container.
ARG USERNAME=ubuntu
RUN echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Qt (the toolkit of the Gazebo GUI) needs a private runtime directory
# owned by the user, with 0700 permissions.
ENV XDG_RUNTIME_DIR=/tmp/runtime-$USERNAME
RUN mkdir -p $XDG_RUNTIME_DIR && \
    chown -R $USERNAME:$USERNAME $XDG_RUNTIME_DIR && \
    chmod 0700 $XDG_RUNTIME_DIR

# Everything below, and the running container, uses this user (not root).
USER $USERNAME

# -----------------------------------------------------------------------------
# ArduSub SITL
# -----------------------------------------------------------------------------
# Clones ArduPilot at a fixed ArduSub release and compiles ArduSub for the
# "sitl" board, i.e. as a normal Linux program instead of Pixhawk firmware.
#   --depth 1 / --shallow-submodules - no git history, much smaller download
#   --recurse-submodules - ArduPilot needs its submodules (MAVLink, waf, ...)
#   ./waf configure --board sitl     - select the Linux/SITL target
#   ./waf sub                        - build only ArduSub (not Copter, Plane...)
# Result: /home/ubuntu/ardupilot/build/sitl/bin/ardusub
#
# Built as $USERNAME, not root, because sim_vehicle.py writes into this tree
# when it runs (parameter file eeprom.bin, logs, build lock files).
# Cloned outside ~/workspace on purpose: ~/workspace is bind-mounted from the
# host by docker-compose.yaml and would hide anything the image put there.
#
# To change the ArduSub version, change ARDUSUB_VERSION (tags look like
# Sub-4.7.2; ArduSub-stable points to the latest stable one).
ARG ARDUSUB_VERSION=Sub-4.7.2
RUN git clone --branch ${ARDUSUB_VERSION} --depth 1 \
        --recurse-submodules --shallow-submodules \
        https://github.com/ArduPilot/ardupilot.git /home/$USERNAME/ardupilot \
    && cd /home/$USERNAME/ardupilot \
    && ./waf configure --board sitl \
    && ./waf sub

# -----------------------------------------------------------------------------
# ardupilot_gazebo plugin - system packages
# -----------------------------------------------------------------------------
# rapidjson-dev    - JSON library; ArduSub and the plugin exchange JSON
# libopencv-dev, libgstreamer*-dev - only needed by GstCameraPlugin, which is
#                    built from the same repository; CMake refuses to configure
#                    without them even though we do not use that plugin.
# Installed here, below the ArduSub layer, so that adding them did not force a
# recompile of ArduSub. apt needs root, so switch to root and back.
USER root
RUN apt-get update && apt-get install -y \
    rapidjson-dev \
    libopencv-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*
USER $USERNAME

# -----------------------------------------------------------------------------
# ardupilot_gazebo plugin - build
# -----------------------------------------------------------------------------
# GZ_VERSION selects the Gazebo release the plugin is compiled against.
# ROS 2 Jazzy ships Gazebo Harmonic, so it must be "harmonic".
#
# The repository has no release tags, so a specific commit is pinned to make
# the build reproducible. To update, replace ARDUPILOT_GAZEBO_COMMIT with a
# newer commit hash from https://github.com/ArduPilot/ardupilot_gazebo.
#
# Gazebo here comes from ROS vendor packages (/opt/ros/jazzy/...), so CMake can
# only find gz-sim8 after the ROS environment is sourced. Docker's RUN uses sh,
# which has no "source", hence the explicit bash -c.
# Result: /home/ubuntu/ardupilot_gazebo/build/libArduPilotPlugin.so
ENV GZ_VERSION=harmonic
ARG ARDUPILOT_GAZEBO_COMMIT=80dc9664dda7efd6c5d1a71a79198d1d6b708c0e
RUN git clone https://github.com/ArduPilot/ardupilot_gazebo.git /home/$USERNAME/ardupilot_gazebo \
    && cd /home/$USERNAME/ardupilot_gazebo \
    && git checkout ${ARDUPILOT_GAZEBO_COMMIT} \
    && mkdir build && cd build \
    && bash -c "source /opt/ros/jazzy/setup.bash && cmake .. -DCMAKE_BUILD_TYPE=RelWithDebInfo && make -j4"

# The bind-mounted repo folder (bluespark-simulation/workspace on the host).
WORKDIR /home/$USERNAME/workspace

# -----------------------------------------------------------------------------
# Shell environment, appended to ~/.bashrc (applies to every new terminal)
# -----------------------------------------------------------------------------
# Lines in single quotes keep $VARIABLES unexpanded, so they are evaluated
# when a terminal starts, not at image build time.

# ROS 2 commands (ros2 ...) and the Gazebo vendor libraries.
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc
# Where Gazebo resolves model:// URIs (pool, robosub25_gate, bluerov2).
RUN echo "export GZ_SIM_RESOURCE_PATH=/home/ubuntu/workspace/models:$GZ_SIM_RESOURCE_PATH" >> ~/.bashrc
# Where Gazebo looks for system plugins: lets <plugin filename="libArduPilotPlugin.so">
# in model.sdf find the library built above. Appended to the existing value so
# the plugin paths set by ROS are kept.
RUN echo 'export GZ_SIM_SYSTEM_PLUGIN_PATH=$HOME/ardupilot_gazebo/build:$GZ_SIM_SYSTEM_PLUGIN_PATH' >> ~/.bashrc
# Makes sim_vehicle.py (ArduPilot's SITL launcher) callable from any directory.
RUN echo 'export PATH=$PATH:$HOME/ardupilot/Tools/autotest' >> ~/.bashrc
