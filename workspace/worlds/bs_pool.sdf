<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="bs_pool">
    <physics name="1ms" type="dart"> <!-- TODO: Chose appropriate physics engine-->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        <render_engine>ogre</render_engine>
    </plugin>

    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <!-- Underwater Physics plugins -->
    <plugin
        filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>


    <!-- Gravity that would be great underwater -->
    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Pool Model-->
    <include>
        <name>pool_structure</name>
        <uri>model://pool</uri>
        <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Gate Model -->
    <include>
        <name>gate25</name>
        <uri>model://robosub25_gate</uri>
        <pose>0 0 -2 0 0 0</pose>
    </include>

    <!-- BlueROV2 -->
    <include>
        <name>bluerov2</name>
        <uri>model://bluerov2</uri>
        <pose>-3 0 -1 0 0 0</pose>
    </include>

    <!-- NOTE: Do not include pool waves rn as this is purely aesthetics -->
    <!-- <include>
        <name>pool_water</name>
        <uri>model://pool_waves</uri>
        <pose>0 0 0 0 0 0</pose>
    </include> -->
  </world>
</sdf>
